# Security headers for hosts that support a `_headers` file
# (Netlify, Cloudflare Pages, and anything speaking the same format).
#
# GitHub Pages cannot send custom response headers, which is why index.html
# also carries the CSP as a <meta http-equiv> tag. That meta tag covers the
# script/style/connect surface; the three directives below CANNOT be expressed
# in meta and need a real header, so they only exist when the site is served by
# a host that reads this file (or by tools/serve.py, which sets all of them):
#
#   Content-Security-Policy: frame-ancestors 'none'   clickjacking
#   Cross-Origin-Opener-Policy                        cross-origin isolation
#   Cross-Origin-Embedder-Policy                      cross-origin isolation
#
# Paths are relative to this file, so the same rules apply at '/' and at a
# subpath deployment such as '/PROJECT-SINGULARITY/'.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'sha256-D8RsBe73+hQNEi9euZQpWQ7YfIhNc/aUbtvz7W1QK/Y='; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Deliberately NO `Cache-Control` on `/*`, and no extension-glob rules either
# (`/*.css`, `/*.js`). Both were tried against the live host and measured:
#
#   * a catch-all `no-store` combined with a per-type `max-age` is delivered as
#     the self-cancelling `no-store, public, max-age=300` on Cloudflare's asset
#     layer, which APPENDS matching rules where Netlify overrides (last match
#     wins) - so the cacheable intent was silently dropped;
#   * partial-segment globs like `/*.css` do not match at all on that layer,
#     while `/*` and exact paths do.
#
# What is left is the common denominator both hosts honour. Everything except
# the worker falls to the host default, `public, max-age=0, must-revalidate` -
# which is the right answer for this app anyway: its asset names carry no
# content hash, so revalidate-always is how a deploy never serves a stale file.
# The service worker is the one exception, and its rule is an exact path.

# The service worker is deliberately revalidated on every load, so a new deploy
# is picked up on the next visit rather than up to five minutes later. Verified
# live: this exact-path rule is delivered (`Cache-Control: no-cache`).
/sw.js
  Cache-Control: no-cache
